<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% if title and not isHome %}{{ title }} | {% endif %}{{ site.title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Noto+Serif+JP:wght@400;500;600&display=swap">
<link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
<header class="bar">
  <a class="home" href="{{ '/' | url }}">{{ site.title }}</a>
  <nav><a href="{{ '/' | url }}">曲の一覧</a><a href="{{ '/about/' | url }}">このサイトについて</a></nav>
</header>
{{ content | safe }}
<footer class="wrap">
  <span class="name">{{ site.title }}</span>
  {{ site.footer }}
</footer>
</body>
</html>
