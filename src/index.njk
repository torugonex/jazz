---
layout: base.njk
isHome: true
---
<section class="hero">
  <p class="eyebrow">{{ site.eyebrow }}</p>
  <h1>{{ site.title }}</h1>
  <div class="rule"></div>
  <p class="lead">{{ site.tagline }}</p>
</section>
<main class="wrap">
  <ul class="list">
  {% for p in collections.tunes %}
    <li><a href="{{ p.url | url }}">
      <span class="date">{{ p.date | dateJa }}</span>
      <span class="t">{{ p.data.title }}</span>
      {% if p.data.title_ja %}<span class="sub">{{ p.data.title_ja }}</span>{% endif %}
    </a></li>
  {% endfor %}
  </ul>
</main>
